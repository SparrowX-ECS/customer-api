    {"type": "timeseries", "title": "Request rate", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}, "targets": [{"expr": "sum(rate(customer_api_http_requests_total{job=\"customer-api\"}[5m]))", "legendFormat": "requests/s"}]},
    {"type": "timeseries", "title": "Error rate", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}, "targets": [{"expr": "sum(rate(customer_api_http_requests_total{job=\"customer-api\",status=~\"4..|5..\"}[5m]))", "legendFormat": "errors/s"}]},
    {"type": "timeseries", "title": "95th percentile latency", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(customer_api_http_request_duration_seconds_bucket{job=\"customer-api\"}[5m])))", "legendFormat": "p95"}]},
    {"type": "timeseries", "title": "HTTP status codes", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}, "targets": [{"expr": "sum by (status) (rate(customer_api_http_requests_total{job=\"customer-api\"}[5m]))", "legendFormat": "{{status}}"}]},
